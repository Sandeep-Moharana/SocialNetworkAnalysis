# The apache/hadoop image turns these variables into XML config files:
#   CORE-SITE.XML_<key>=<value>  ->  <property> in core-site.xml
#   HDFS-SITE.XML_<key>=<value>  ->  <property> in hdfs-site.xml
# Used by the NameNode + DataNode on the master laptop AND the DataNodes on friends' PCs.
# (A friend's DataNode overrides its name and ports in docker-compose.worker.yml.)

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# Metadata and blocks live on Docker volumes mounted at /hdfs (see docker/hdfs/*.sh).
HDFS-SITE.XML_dfs.namenode.name.dir=/hdfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hdfs/data

# Every block is stored on 2 DataNodes (on 2 different PCs), so one laptop can leave.
# With only the master's DataNode running (Phase 1 mode) blocks just have 1 copy
# ("under-replicated"), which still works. Spark clients get the same value from
# spark.hadoop.dfs.replication in spark-defaults.conf.
HDFS-SITE.XML_dfs.replication=2

# Simplicity for the MVP: Spark (user 'spark') and the CLI (user 'hadoop') can both write.
HDFS-SITE.XML_dfs.permissions.enabled=false
# Container IPs have no reverse DNS; don't reject DataNodes because of that.
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false

# --- Multi-PC: names instead of container IPs ---------------------------------
# The name this DataNode reports (friends' DataNodes: "datanode-<name>").
HDFS-SITE.XML_dfs.datanode.hostname=datanode
# Clients (the 'hdfs' CLI here; Spark via spark-defaults.conf) and DataNodes
# (when copying a block to the 2nd replica) connect to DataNodes by that NAME,
# which every PC maps to the right Wi-Fi IP. The NameNode only knows NAT'd IPs.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true

# --- Laptops come and go: notice it quickly -----------------------------------
# No heartbeat for 30 s = "stale": don't read from / write to it if others exist.
HDFS-SITE.XML_dfs.namenode.avoid.read.stale.datanode=true
HDFS-SITE.XML_dfs.namenode.avoid.write.stale.datanode=true
# Declared dead after 2 x 60 s + 10 x 3 s heartbeats = 2.5 min (default 10.5 min);
# then the NameNode re-copies its blocks to keep 2 copies.
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=60000
