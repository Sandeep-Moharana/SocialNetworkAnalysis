# The apache/hadoop image turns these variables into XML config files:
#   CORE-SITE.XML_<key>=<value>  ->  <property> in core-site.xml
#   HDFS-SITE.XML_<key>=<value>  ->  <property> in hdfs-site.xml

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/tmp/hadoop-hadoop/dfs/name
# Only one DataNode (on the master laptop) until step 2.4, so keep one copy of each block.
# Step 2.4 adds DataNodes on friends' PCs and raises this to 2.
HDFS-SITE.XML_dfs.replication=1
# The name the DataNode reports to the NameNode, and that clients connect to
# (with dfs.client.use.datanode.hostname in spark-defaults.conf). Friends' PCs map
# it to the master laptop's IP. Step 2.4 gives each friend's DataNode its own name.
HDFS-SITE.XML_dfs.datanode.hostname=datanode
# Simplicity for the MVP: Spark (user 'spark') and the CLI (user 'hadoop') can both write.
HDFS-SITE.XML_dfs.permissions.enabled=false
# Container IPs have no reverse DNS; don't reject DataNodes because of that.
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
