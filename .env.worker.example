# Phase 2, FRIEND's PC. Copy to .env and fill in the two settings:
#     copy .env.worker.example .env
# .env is git-ignored.

# This PC's name: short, lowercase, letters/digits/'-'. Must match FRIEND_A or
# FRIEND_B in the master laptop's .env. Shows up as "worker-<name>" / "datanode-<name>".
NODE_NAME=alice

# This PC's HDFS data port. MUST BE DIFFERENT on every friend's PC:
#   first friend 9876, second friend 9886   (the master uses 9866)
# Reason: the NameNode sees all friends' DataNodes arriving from one NAT address
# and tells them apart by this port.
DATANODE_PORT=9876

# Optional: how much of this PC the worker may use (defaults: 2 cores, 2g).
# Keep WORKER_MEMORY below the memory= value in this PC's .wslconfig.
# WORKER_CORES=2
# WORKER_MEMORY=2g

# Written automatically by scripts\worker_up.ps1 on every start (it asks the
# master's registry for everyone's current IP). Don't edit by hand.
# MASTER_IP=
# OTHER_FRIEND=
# OTHER_FRIEND_IP=
