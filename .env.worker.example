# Phase 2, FRIEND's PC. Copy to .env and fill in:
#     copy .env.worker.example .env
# .env is git-ignored: IPs change from network to network.

# This PC's name: short, lowercase, letters/digits/'-'. The master laptop's .env
# must use the same name. The worker shows up as "worker-<NODE_NAME>".
NODE_NAME=alice

# The master laptop's Wi-Fi IPv4 address (the master runs 'ipconfig').
MASTER_IP=192.168.1.10

# The OTHER friend's PC (executors exchange data directly). Only one friend so
# far? Leave these as they are; an unused entry does no harm.
OTHER_FRIEND=bob
OTHER_FRIEND_IP=192.168.1.22

# Optional: how much of this PC the worker may use (defaults: 2 cores, 2g).
# Keep WORKER_MEMORY below the memory= value in this PC's .wslconfig.
# WORKER_CORES=2
# WORKER_MEMORY=2g
