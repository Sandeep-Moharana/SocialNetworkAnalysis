# Phase 2, MASTER laptop (yours). Copy to .env and fill in:
#     copy .env.master.example .env
# .env is git-ignored: IPs change from network to network.
#
# Each friend: a short lowercase name (letters, digits, '-') and their Wi-Fi IPv4
# address (they run 'ipconfig'). The name must match NODE_NAME in THEIR .env.
# Only one friend so far? Leave FRIEND_B as it is; an unused entry does no harm.
FRIEND_A=alice
FRIEND_A_IP=192.168.1.21
FRIEND_B=bob
FRIEND_B_IP=192.168.1.22
