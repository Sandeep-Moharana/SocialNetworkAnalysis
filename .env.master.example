# Phase 2, MASTER laptop (yours). Copy to .env and fill in the two names:
#     copy .env.master.example .env
# .env is git-ignored.
#
# The friends' names: short, lowercase (letters, digits, '-'). Each must match
# NODE_NAME in that friend's .env. Only one friend so far? Leave FRIEND_B as it is.
FRIEND_A=alice
FRIEND_B=bob

# Written automatically by scripts\cluster_up.ps1 on every start (the registry tells
# it each friend's current IP). Don't edit by hand.
# MASTER_IP=
# FRIEND_A_IP=
# FRIEND_B_IP=
